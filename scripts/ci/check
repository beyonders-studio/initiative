#!/usr/bin/env bash
# The fast checks CI runs, runnable on your machine. CI calls this same script
# for these steps, so a failure here is the failure CI would report.
#
# Usage:
#   scripts/ci/check              # the checks for what this branch changed
#   scripts/ci/check all          # every check
#   scripts/ci/check <name>...    # named checks, or the groups backend / frontend
#
# Checks:
#   ruff        Python lint
#   format      Python formatting
#   ty          Python type check
#   migrations  no released migration edited; one Alembic head
#   biome       frontend lint
#   tsc         frontend type check
#   codegen     env-contract.json and the generated API client match the backend
#
# BASE_REF is what "changed" and "released migration edited" compare against:
# origin/dev by default, the pull request's base in CI.
#
# Needs backend/.venv (cd backend && uv sync) and frontend/node_modules
# (cd frontend && pnpm install). No database, no server, no tests.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

BASE_REF="${BASE_REF:-origin/dev}"
FAILED=()

say() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
# In GitHub Actions, also an annotation on the run.
error() {
  if [[ -n "${GITHUB_ACTIONS:-}" ]]; then echo "::error::$*"; else echo "$*"; fi
}

backend() { (cd backend && uv run --no-sync "$@"); }
frontend() { (cd frontend && pnpm "$@"); }

# Every Python file in the repo, run from backend/: the app, its scripts and
# migrations, and the repo-level scripts. The repo-level scripts import their
# siblings, so ty searches their directories too.
PYTHON=(app scripts alembic conftest.py ../scripts)
check_ruff() { backend ruff check "${PYTHON[@]}"; }
check_format() { backend ruff format --check "${PYTHON[@]}"; }
check_ty() { backend ty check "${PYTHON[@]}" --extra-search-path ../scripts --extra-search-path ../scripts/ci; }
check_biome() { frontend lint; }
check_tsc() { frontend typecheck; }

check_migrations() {
  # A revision already on the base branch is fixed; edit, rename or delete
  # one and this fails, unless a commit on the branch names it in an
  # Edits-merged-migration trailer (an edit the owner ruled), or it is deleted
  # at or before the chain's baseline (collapsed into it by
  # backend/scripts/collapse_migrations.py). --no-renames reports a rename as
  # the old path deleted, so the merged name is checked.
  local edited named baseline status file name collapsed=0 unnamed=()
  if ! git rev-parse --verify --quiet "$BASE_REF^{commit}" >/dev/null; then
    error "Cannot compare against $BASE_REF: it does not exist here. Run 'git fetch origin dev', or set BASE_REF."
    return 1
  fi
  edited=$(git diff --name-status --no-renames --diff-filter=MDT "$BASE_REF...HEAD" -- backend/alembic/versions)
  named=$(git log --format='%(trailers:key=Edits-merged-migration,valueonly)' "$BASE_REF..HEAD")
  baseline=$(backend python -c "
from alembic.config import Config
from alembic.script import ScriptDirectory
print(ScriptDirectory.from_config(Config('alembic.ini')).get_base())
")
  while IFS=$'\t' read -r status file; do
    [[ -z "$file" ]] && continue
    name=$(basename "$file")
    if [[ "$status" == D && ! "${name:0:13}" > "$baseline" ]]; then
      collapsed=$((collapsed + 1))
    elif grep -qxF "$name" <<<"$named"; then
      echo "Merged migration edited, named in a commit: $file"
    else
      unnamed+=("$file")
    fi
  done <<<"$edited"
  ((collapsed)) && echo "$collapsed merged revisions collapsed into the baseline $baseline."
  if ((${#unnamed[@]})); then
    error "Edited, renamed or removed a merged migration: ${unnamed[*]}"
    echo "Add a new revision instead (AGENTS.md, \"Never edit a migration\")."
    return 1
  fi
  [[ -z "$edited" ]] && echo "No merged migration edited."

  # get_current_head() raises when the revisions have more than one head.
  backend python -c "
from alembic.config import Config
from alembic.script import ScriptDirectory
print('One Alembic head:', ScriptDirectory.from_config(Config('alembic.ini')).get_current_head())
"
}

check_codegen() {
  local spec spec_dir generated=(env-contract.json frontend/src/api/generated)
  # Regenerating writes over these files, so they must hold nothing that is
  # not committed yet. (CI always starts from a clean checkout.)
  if [[ -n "$(git status --porcelain -- "${generated[@]}")" ]]; then
    git status --short -- "${generated[@]}"
    error "These generated files have uncommitted changes, which regenerating would overwrite."
    echo "Commit them (or discard them), then run the check again."
    return 1
  fi
  (cd backend && uv run --no-sync python ../scripts/build_env_contract.py)
  # A directory, not `mktemp --suffix`: macOS's mktemp has no suffix option.
  spec_dir=$(mktemp -d)
  spec="$spec_dir/openapi.json"
  backend python scripts/export_openapi.py "$spec"
  frontend/scripts/generate-api.sh --from-spec "$spec" >/dev/null
  rm -rf "$spec_dir"
  if [[ -n "$(git status --porcelain -- "${generated[@]}")" ]]; then
    git status --short -- "${generated[@]}"
    if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
      git --no-pager diff HEAD -- "${generated[@]}"
    else
      git --no-pager diff --stat HEAD -- "${generated[@]}"
    fi
    echo
    error "Regenerated from the backend, and it differs from what is committed."
    echo "Run scripts/ci/check codegen locally: it regenerates them. Review and commit the result."
    return 1
  fi
  echo "env-contract.json and the generated API client are up to date."
}

# What this branch changed against BASE_REF, committed or not.
changed_paths() {
  {
    git diff --name-only "$BASE_REF...HEAD" 2>/dev/null || echo "(no base)"
    git diff --name-only HEAD
    git ls-files --others --exclude-standard
  } | sort -u
}

checks_for_changes() {
  local changed
  changed=$(changed_paths)
  # No base to compare with, or a change to the checks themselves: run them all.
  if grep -qx "(no base)" <<<"$changed" \
    || grep -qE '^(scripts/ci/|\.github/workflows/ci\.yml$|\.github/actions/|frontend/\.husky/)' <<<"$changed"; then
    echo "all"
    return
  fi
  if grep -qE '^backend/|^scripts/.*\.py$' <<<"$changed"; then
    echo "ruff format ty"
  fi
  if grep -q '^backend/alembic/' <<<"$changed"; then
    echo "migrations"
  fi
  if grep -q '^frontend/' <<<"$changed"; then
    echo "biome tsc"
  fi
  # The same paths CI's codegen check watches.
  if grep -qE '^(backend/|frontend/orval\.config\.ts$|frontend/src/api/mutator\.ts$|frontend/package\.json$|frontend/scripts/generate-api\.sh$|scripts/build_env_contract\.py$|env-contract\.json$)' <<<"$changed"; then
    echo "codegen"
  fi
}

expand() {
  case "$1" in
    all) echo "ruff format ty migrations biome tsc codegen" ;;
    backend) echo "ruff format ty migrations" ;;
    frontend) echo "biome tsc" ;;
    ruff | format | ty | migrations | biome | tsc | codegen) echo "$1" ;;
    *)
      echo "Unknown check: $1 (see scripts/ci/check --help)" >&2
      exit 2
      ;;
  esac
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

if [[ $# -eq 0 ]]; then
  # shellcheck disable=SC2046 # one check name per word
  set -- $(checks_for_changes)
  if [[ $# -eq 0 ]]; then
    echo "Nothing to check: no backend or frontend changes against $BASE_REF."
    exit 0
  fi
fi

CHECKS=()
for arg in "$@"; do
  for name in $(expand "$arg"); do
    [[ " ${CHECKS[*]-} " == *" $name "* ]] || CHECKS+=("$name")
  done
done

for name in "${CHECKS[@]}"; do
  say "$name"
  # A function called as `f || …` runs with -e off, so a failed step would not
  # stop its check. The subshell keeps -e on inside it.
  set +e
  (
    set -e
    "check_$name"
  )
  status=$?
  set -e
  [[ $status -eq 0 ]] || FAILED+=("$name")
done

echo
if [[ ${#FAILED[@]} -gt 0 ]]; then
  echo "Failed: ${FAILED[*]}"
  exit 1
fi
echo "Passed: ${CHECKS[*]}"
