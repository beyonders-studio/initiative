{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/node_modules",
      "!**/public",
      "!**/android",
      "!**/ios",
      // The desktop app's copy of the web build, and what its tools generate
      "!electron/app",
      "!electron/generated",
      "!electron/vendor",
      "!**/pnpm-lock.yaml",
      "!**/package-lock.json",
      // Auto-generated by TanStack Router
      "!src/routeTree.gen.ts",
      // Vendored from the plugin-kit and kept byte-identical to the backend's copy
      // (backend/scripts/refresh_plugin_kit.py writes both). Formatting it here
      // would rewrite a published document and fight every refresh.
      "!src/contract",
      // Vite/Vitest/Capacitor configs are ignored to match the previous eslint setup
      "!vite.config.ts",
      "!vite.config.js",
      "!vitest.config.*",
      "!capacitor.config.*",
      "!orval.config.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  // The width classes are the app's only widths: see styles.css.
  "plugins": [
    "./biome-plugins/no-other-widths.grit",
    "./biome-plugins/no-other-widths-css.grit",
    "./biome-plugins/one-formatter.grit",
    "./biome-plugins/no-gap-margins.grit"
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        // Useful but very noisy on existing code — keep as warnings instead of errors.
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "warn",
        "useFocusableInteractive": "warn",
        "noNoninteractiveTabindex": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noSvgWithoutTitle": "off",
        "useAltText": "warn",
        "useButtonType": "warn"
      },
      "correctness": {
        // exhaustive-deps was a `warn` in the eslint config. Keep it warning
        // for *missing* deps, but never flag "extra" deps — codebases use
        // intentional trigger-deps (reset page on filter change, etc.) that
        // biome's autofix would otherwise strip and break.
        "useExhaustiveDependencies": {
          "level": "warn",
          "options": {
            "reportUnnecessaryDependencies": false
          }
        },
        // Recommended, but only a warning by default, and `biome lint` exits 0
        // on warnings — so CI scrolled past these. Imports and bindings nothing
        // reads are leftovers from a move or a rename; clear them with the
        // change that made them.
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "off",
        "noUnusedPrivateClassMembers": "warn",
        "useJsxKeyInIterable": "warn"
      },
      "complexity": {
        "noUselessFragments": "off",
        "useOptionalChain": "warn",
        "useLiteralKeys": "off",
        "noFlatMapIdentity": "warn"
      },
      "performance": {
        "noAccumulatingSpread": "warn"
      },
      "security": {
        // Used intentionally for sanitized Markdown / Lexical content
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        // Restrict direct React Query hooks outside of src/api and src/hooks
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@tanstack/react-query": {
                "importNames": ["useQuery", "useQueryClient", "useMutation"],
                "message": "Use domain hooks from @/hooks/ instead of direct React Query imports. Only src/api/ and src/hooks/ may use query hooks directly."
              }
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noShadowRestrictedNames": "warn",
        "noDuplicateProperties": "warn",
        "noImplicitAnyLet": "warn",
        "useIterableCallbackReturn": "warn",
        "noDocumentCookie": "warn",
        "noGlobalIsNan": "warn"
      },
      "nursery": {
        // Replaces prettier-plugin-tailwindcss. A safe fix sorts classes on every
        // `biome check --write`, the pre-commit hook included, as the plugin did.
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "attributes": ["className"],
            "functions": ["cn", "clsx", "cva", "tw"]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":BUN:", ":PACKAGE_WITH_PROTOCOL:"],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Auto-generated by Orval — format only, never lint
      "includes": ["src/api/generated/**"],
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // Auto-generated by wasm-pack from crypto/ — rebuilt by
      // scripts/build-crypto.sh, never edited here
      "includes": ["src/crypto/wasm/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // Allow direct React Query imports in api, hooks, and bootstrap files
      "includes": [
        "src/api/**",
        "src/hooks/**",
        "src/lib/queryClient.ts",
        "src/main.tsx",
        "src/router.tsx",
        "src/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // The UI kit our plug-ins copy imports nothing of Initiative's. Its tests
      // stay in Initiative and aren't copied.
      "includes": ["src/ui/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": ["./biome-plugins/ui-imports-only-ui.grit"]
    },
    {
      // UI primitives, the editor and tests: relax rules that aren't worth fixing here
      "includes": [
        "src/ui/**",
        "src/components/editor/**",
        "src/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "useFocusableInteractive": "off",
            "useButtonType": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      // Widget modules are sandbox entry points, not app modules: they are
      // loaded as source text and their top-level `render` is called by the
      // QuickJS runtime, never imported. Biome can only see an unused function.
      "includes": ["src/lib/widgets/builtins/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
