{
  "name": "initiative-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:capacitor": "tsc -b && cross-env CAPACITOR_BUILD=true vite build",
    "cap:android": "pnpm build:capacitor && npx cap sync android && npx cap run android",
    "cap:ios": "pnpm build:capacitor && npx cap sync ios && npx cap run ios",
    "cap:desktop": "pnpm build:capacitor && pnpm --dir electron install && pnpm --dir electron build:plugins && cap sync @capawesome/capacitor-electron && cap run @capawesome/capacitor-electron",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check": "biome check ./src",
    "check:fix": "biome check ./src --write",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint ./src --write",
    "format": "biome format ./src --write",
    "format:api": "biome format ./src/api/generated --write --no-errors-on-unmatched",
    "test": "vitest",
    "test:run": "vitest run",
    "test:journeys": "playwright test --project=journeys",
    "screenshots": "bash ../scripts/screenshots.sh",
    "generate:api": "./scripts/generate-api.sh",
    "build:crypto": "./scripts/build-crypto.sh",
    "prepare": "cd .. && husky ./frontend/.husky",
    "build:editor-server": "node scripts/build-editor-server.mjs"
  },
