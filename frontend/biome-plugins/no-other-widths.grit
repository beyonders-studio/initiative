// The widths are Tailwind's sm: … xl:, set in src/ui/styles.css, and the canvas-sm: …
// canvas-xl: variants beside them. Any other width is refused: 2xl:,
// Tailwind's container sizes as variants (@xs:, @md: …), an arbitrary width
// variant, and a width media or container query written into a string.
language js

or {
  JsStringLiteralExpression(),
  JsxString(),
  JsTemplateChunkElement()
} as $text where {
  or {
    $text <: r"(?s).*(?:^|[\s\"'`{(,:!])(?:max-)?(?:xs|[2-7]xl):.*",
    $text <: r"(?s).*(?:^|[\s\"'`{(,:!])@(?:max-|min-)?(?:3xs|2xs|xs|sm|md|lg|xl|[2-7]xl):.*",
    $text <: r"(?s).*(?:^|[\s\"'`{(,:!])(?:max-|min-|@max-|@min-|@)\[[^\]]*\]:.*",
    $text <: r"(?s).*\(\s*(?:(?:min-|max-)?width\s*:\s*[\d.]|width\s*[<>]=?\s*[\d.]|[\d.]+\s*(?:px|r?em|vw|ch)?\s*[<>]=?\s*width).*"
  },
  register_diagnostic(
    span=$text,
    message="Only sm:, md:, lg: and xl: set a width (canvas-sm: … for a region; useWidthClass and useRegionWidthClass in code). Grids, forms and rows fill or wrap instead (grid-cols-fill-*, grid-cols-pair, flex-wrap). See the widths in src/ui/styles.css.",
    severity="error"
  )
}
