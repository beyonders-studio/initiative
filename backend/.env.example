# Initiative backend configuration.
# Copy to .env and fill in the required section. Everything else is optional —
# most of it can be configured later in the app under Settings → Platform.

# --- Required ------------------------------------------------------------------

# Generate with: openssl rand -hex 32
# Never swap this on an existing install — it encrypts stored data. To rotate it
# safely, see PREVIOUS_SECRET_KEY under "Advanced" below.
SECRET_KEY=

# The Postgres database, connecting as its owner. The app makes its own
# least-privilege logins from this at startup.
DATABASE_URL=postgresql+asyncpg://initiative:initiative@localhost:5432/initiative

# The address people open Initiative at, such as https://initiative.example.com.
# Links in emails and sign-in redirects use it. (This value is the local dev
# server's.)
APP_URL=http://localhost:5173

# --- Common options (defaults shown) --------------------------------------------

# Bootstrap owner. Leave unset (default) and the first person who signs up
# becomes the platform owner — simplest and avoids a shared password. Or set
# both to auto-create the owner on first boot; if you do, pick a strong
# password — the bootstrap path does NOT apply the normal password policy.
# FIRST_OWNER_EMAIL=owner@example.com
# FIRST_OWNER_PASSWORD=

# How long somebody stays signed in. The browser renews silently every
# AUTH_ACCESS_TTL_MINUTES, and the session survives that many days of not
# using the app at all.
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
# The next three, the breach check and the export wait below are read on the
# first start only. After that, change them in Settings → Platform.
# Allow anyone to register (false = new users need an invite code).
ENABLE_PUBLIC_REGISTRATION=true
# Stop members from creating new communities.
DISABLE_GUILD_CREATION=false
# Communities one account may create in a day (0 = no limit). Operators and
# owners are not limited.
GUILD_CREATION_DAILY_LIMIT=5
# Set true behind a reverse proxy (nginx, Traefik, Caddy, a Cloudflare Tunnel
# or Cloudflare's proxy), so rate limits and sign-in records see each visitor
# rather than the proxy. A proxy on this machine or your LAN, and Cloudflare
# in front of it, need nothing else. The log says so if you forget.
BEHIND_PROXY=false
# Only for a proxy that reaches Initiative over a public address: list it, and
# any other proxy you trust (comma-separated). The log names it when it's needed.
# FORWARDED_ALLOW_IPS=203.0.113.10
# Extra browser origins allowed to call the API, beyond APP_URL. No "*".
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Production hardening (defaults shown) ---------------------------------------

# Reject passwords that appear in known breaches (HaveIBeenPwned; only a
# 5-char hash prefix leaves the server). Set false for air-gapped installs.
# First start only; after that it's in Settings → Platform → Security.
HIBP_CHECK_ENABLED=true
# How much the app says about itself on stderr (DEBUG, INFO, WARNING, ERROR).
# The audit stream on stdout is not governed by this.
LOG_LEVEL=INFO
# Rate limit for routes without their own limit, per signed-in account (per IP
# before sign-in). memory:// counts in each process; a redis:// URL shares one
# count across processes.
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STORAGE_URI=memory://
# Bearer token Prometheus presents to read /api/v1/metrics (openssl rand -hex 32).
# Unset, that endpoint answers 404.
# METRICS_TOKEN=
# Grafana Faro collector the browser sends page views, errors and Web Vitals to
# (a path like /collect, or an https:// URL). Only browsers that switch on
# Analytics in the cookie chooser send anything. Unset, nothing loads.
# FARO_COLLECTOR_URL=
# In-app MCP server at /api/v1/mcp/ (personal API keys, acts as the calling user).
ENABLE_MCP=false

# --- Optional integrations -------------------------------------------------------
# OIDC, SMTP, push (FCM_*) and captcha settings here only pre-fill the platform
# settings on FIRST boot (OIDC seeds the sign-in provider entry once; issuer +
# client id required); after that the app UI owns them. Prefer configuring them
# in Settings → Platform.

# OIDC single sign-on
# OIDC_ENABLED=true
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Example SSO
# OIDC_SCOPES=openid,profile,email,offline_access

# Which ways in the deployment permits: any of password, sso, passkey, totp,
# email_otp. Read on the first boot only, like OIDC_* above; Settings ->
# Platform -> Authentication owns it afterwards. Unset keeps the default.
# AUTH_LOGIN_METHODS=password,sso,passkey,totp

# Outgoing email (SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REJECT_UNAUTHORIZED=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS="Initiative <no-reply@example.com>"

# Mobile push notifications (Firebase) — see docs/en/running-a-server/push-notifications.md
FCM_ENABLED=false
# FCM_PROJECT_ID=
# FCM_APPLICATION_ID=
# FCM_API_KEY=
# FCM_SENDER_ID=
# FCM_SERVICE_ACCOUNT_JSON=

# Captcha on public registration: hcaptcha, turnstile, or recaptcha (v2 keys only).
# CAPTCHA_PROVIDER=
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# Marketplace and plug-ins: nothing to set. The server follows the Initiative
# registry, and plug-ins are set up under Settings -> Platform -> Integrations.

# File storage: "local" (default, saved under UPLOADS_DIR) or "s3" (any
# S3-compatible store — see docs/en/running-a-server/object-storage.md).
STORAGE_BACKEND=local
UPLOADS_DIR=uploads
# S3_BUCKET=
# S3_REGION=garage
# S3_ENDPOINT_URL=http://garage:3900
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_USE_PATH_STYLE=true
# S3_LOCAL_FALLBACK=false

# Where a community export too large to download is written instead. Any
# directory this server can write to — a NAS mount, an encrypted volume. Left
# unset, an export over the download limit is refused rather than produced
# with nowhere to go. Collect the files yourself; they are not deleted for you.
# EXPORT_DESTINATION_DIR=/srv/initiative-exports
# EXPORT_MAX_DOWNLOAD_BYTES=2147483648
# With S3 storage, let finished exports download straight from the bucket
# instead of through the app. Needs your bucket's CORS rules to allow this
# app's origin; leave off until they do.
# EXPORT_PRESIGNED_DOWNLOADS=false
# Hours a community must wait between whole-community exports (0 disables).
# First start only, like the breach check.
# EXPORT_GUILD_COOLDOWN_HOURS=48

# Your own marketplace listings: a mounted directory of listing files this
# server publishes beside the built-in ones — see
# docs/en/running-a-server/publishing-listings.md. Unset means no directory is read.
# MARKETPLACE_EXTRA_CATALOG_DIR=/app/marketplace-catalog

# --- Advanced --------------------------------------------------------------------

# Rotating SECRET_KEY: move the old key here, set a new SECRET_KEY, and restart —
# the app re-encrypts stored data on startup. Remove once the logs report success.
# PREVIOUS_SECRET_KEY=
# Separate signing key for session tokens. Rotating it just signs everyone out.
# Same strength rules as SECRET_KEY; falls back to SECRET_KEY when unset.
# JWT_SIGNING_KEY=
# Naming the database logins yourself (for a pooler, or a database set up by
# someone else): set DATABASE_URL to app_provisioner and add the two below.
# DATABASE_URL_BOOTSTRAP is then the owner, used at startup to create or update
# the three logins; without it the app only checks that they exist.
# DATABASE_URL_APP=postgresql+asyncpg://app_user:<password>@localhost:5432/initiative
# DATABASE_URL_ADMIN=postgresql+asyncpg://app_admin:<password>@localhost:5432/initiative
# DATABASE_URL_BOOTSTRAP=postgresql+asyncpg://<owner>:<password>@localhost:5432/initiative
# Where live updates hold their own database connection. Uses the app's own
# connection when unset, which is right unless the app reaches Postgres through a connection
# pooler — those hand out a different connection per query, which this cannot
# use. Point it straight at Postgres in that case.
# DATABASE_URL_LISTEN=
# Connections each database pool keeps open, and how many more it may open
# under load. Defaults: 5 and 10.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# A mirror of the Initiative registry, for a network that can't reach it
# directly. Listings are still checked against the key built into Initiative.
# The token is for a mirror that asks for one.
# MARKETPLACE_REGISTRY_URL=https://beyonders-studio.github.io/initiative-developer/public/
# MARKETPLACE_REGISTRY_TOKEN=
# MARKETPLACE_REGISTRY_TTL_SECONDS=900
# Trust a registry signed with other keys instead of the Initiative registry.
# MARKETPLACE_REGISTRY_ROOT=/path/to/root.json
# Set plug-ins up from a mounted JSON file at every start, in place of the
# Integrations form — see docs/en/running-a-server/plugins.md.
# PLUGIN_SERVICES_CONFIG=/etc/initiative/plugin-services.json
