{
  "uid": "TSJVTCM0S7GV2X",
  "public_id": "core.counters",
  "kind": "plugin",
  "name": "Counters",
  "publisher": "Initiative",
  "description": "Numbers that move: tallies, totals, scores, seats left, hit points.",
  "long_description": "Groups of named numbers that people in an initiative step up and down.\n\nEach counter keeps its own step, its own floor and ceiling, its color, and the value a reset puts it back to. Counters show as a number, a progress bar or a segmented clock. Reset one counter, or the whole group at once.\n\nA counter linked to a task holds the task up until it reaches its max. Counter groups are shared, tagged, linked, commented on, archived and exported like every other tool.",
  "avatar_url": "/marketplace/core-counters.png",
  "images": [
    "/marketplace/counters-groups.webp",
    "/marketplace/counters-group.webp",
    "/marketplace/counters-full-screen.webp"
  ],
  "version": "1.0.0",
  "release_notes": "Counters as a tool plug-in, with the fields, looks and resets of the built-in tool. Needs an Initiative serving plug-in API 11.1.",
  "definition": {
    "plugin_kind": "tool",
    "tool": {
      "key": "counter_group",
      "name": {
        "en": "Counters",
        "de": "Zähler",
        "es": "Contadores",
        "fr": "Compteurs"
      },
      "instance_name": {
        "en": "Counter group",
        "de": "Zählergruppe",
        "es": "Grupo de contadores",
        "fr": "Groupe de compteurs"
      },
      "icon": "gauge",
      "fields": [
        {
          "key": "description",
          "name": {
            "en": "Description",
            "de": "Beschreibung",
            "es": "Descripción",
            "fr": "Description"
          },
          "kind": "text"
        }
      ],
      "layouts": {
        "lists": [
          {
            "kind": "grid",
            "card": {
              "type": "card",
              "children": [
                {
                  "type": "items",
                  "props": {
                    "item": "counter",
                    "fields": [
                      "name",
                      "count"
                    ],
                    "limit": 4,
                    "tint": "color"
                  }
                },
                {
                  "type": "field",
                  "props": {
                    "field": "name"
                  }
                },
                {
                  "type": "stack",
                  "props": {
                    "tone": "muted"
                  },
                  "children": [
                    {
                      "type": "field",
                      "props": {
                        "field": "description"
                      }
                    }
                  ]
                },
                {
                  "type": "field",
                  "props": {
                    "field": "tags"
                  }
                }
              ]
            }
          },
          {
            "kind": "table",
            "columns": [
              "name",
              "description",
              "tags",
              "updated_at"
            ]
          }
        ],
        "detail": {
          "header": [
            {
              "type": "stack",
              "props": {
                "direction": "row",
                "gap": "sm",
                "align": "start"
              },
              "children": [
                {
                  "type": "field",
                  "props": {
                    "field": "name"
                  }
                },
                {
                  "type": "actions"
                }
              ]
            },
            {
              "type": "stack",
              "props": {
                "tone": "muted"
              },
              "children": [
                {
                  "type": "field",
                  "props": {
                    "field": "description"
                  }
                }
              ]
            },
            {
              "type": "stack",
              "props": {
                "direction": "row",
                "gap": "sm",
                "wrap": true
              },
              "children": [
                {
                  "type": "field",
                  "props": {
                    "field": "tags"
                  }
                },
                {
                  "type": "properties"
                }
              ]
            }
          ],
          "main": [
            {
              "type": "relations"
            },
            {
              "type": "comments"
            }
          ]
        }
      },
      "items": [
        {
          "key": "counter",
          "name": {
            "en": "Counter",
            "de": "Zähler",
            "es": "Contador",
            "fr": "Compteur"
          },
          "fields": [
            {
              "key": "count",
              "name": {
                "en": "Count",
                "de": "Stand",
                "es": "Valor",
                "fr": "Valeur"
              },
              "kind": "counter",
              "counter": {
                "min": "min",
                "max": "max",
                "step": "step",
                "initial": "initial_count"
              }
            },
            {
              "key": "min",
              "name": {
                "en": "Min",
                "de": "Min.",
                "es": "Mínimo",
                "fr": "Min"
              },
              "kind": "number"
            },
            {
              "key": "max",
              "name": {
                "en": "Max",
                "de": "Max.",
                "es": "Máximo",
                "fr": "Max"
              },
              "kind": "number"
            },
            {
              "key": "step",
              "name": {
                "en": "Step",
                "de": "Schrittweite",
                "es": "Incremento",
                "fr": "Pas"
              },
              "kind": "number",
              "default": 1,
              "required": true
            },
            {
              "key": "initial_count",
              "name": {
                "en": "Initial value",
                "de": "Anfangswert",
                "es": "Valor inicial",
                "fr": "Valeur initiale"
              },
              "kind": "number",
              "default": 0,
              "required": true
            },
            {
              "key": "color",
              "name": {
                "en": "Color",
                "de": "Farbe",
                "es": "Color",
                "fr": "Couleur"
              },
              "kind": "color",
              "default": "random"
            },
            {
              "key": "view_mode",
              "name": {
                "en": "View mode",
                "de": "Ansichtsmodus",
                "es": "Modo de visualización",
                "fr": "Mode d’affichage"
              },
              "kind": "select",
              "default": "number",
              "required": true,
              "options": [
                {
                  "value": "number",
                  "label": {
                    "en": "Number",
                    "de": "Zahl",
                    "es": "Número",
                    "fr": "Nombre"
                  }
                },
                {
                  "value": "bar",
                  "label": {
                    "en": "Progress bar",
                    "de": "Fortschrittsbalken",
                    "es": "Barra de progreso",
                    "fr": "Barre de progression"
                  }
                },
                {
                  "value": "clock",
                  "label": {
                    "en": "Segmented clock",
                    "de": "Kreis (Uhr)",
                    "es": "Reloj segmentado",
                    "fr": "Horloge segmentée"
                  }
                }
              ]
            }
          ],
          "checks": [
            {
              "field": "min",
              "at_most": {
                "field": "max"
              }
            },
            {
              "field": "step",
              "above": 0
            }
          ],
          "layouts": {
            "lists": [
              {
                "kind": "grid",
                "card": {
                  "type": "card",
                  "props": {
                    "tint": "color"
                  },
                  "children": [
                    {
                      "type": "field",
                      "props": {
                        "field": "name"
                      }
                    },
                    {
                      "type": "field",
                      "props": {
                        "field": "count"
                      }
                    }
                  ]
                },
                "displays": {
                  "count": {
                    "from": "view_mode"
                  }
                },
                "presets": [
                  {
                    "slug": "name-asc",
                    "name": {
                      "en": "Name (A→Z)",
                      "de": "Name (A→Z)",
                      "es": "Nombre (A→Z)",
                      "fr": "Nom (A→Z)"
                    },
                    "sort": [
                      {
                        "field": "name"
                      }
                    ]
                  },
                  {
                    "slug": "name-desc",
                    "name": {
                      "en": "Name (Z→A)",
                      "de": "Name (Z→A)",
                      "es": "Nombre (Z→A)",
                      "fr": "Nom (Z→A)"
                    },
                    "sort": [
                      {
                        "field": "name",
                        "dir": "desc"
                      }
                    ]
                  },
                  {
                    "slug": "count-asc",
                    "name": {
                      "en": "Count (low→high)",
                      "de": "Stand (niedrig→hoch)",
                      "es": "Valor (menor→mayor)",
                      "fr": "Valeur (croissant)"
                    },
                    "sort": [
                      {
                        "field": "count"
                      },
                      {
                        "field": "name"
                      }
                    ]
                  },
                  {
                    "slug": "count-desc",
                    "name": {
                      "en": "Count (high→low)",
                      "de": "Stand (hoch→niedrig)",
                      "es": "Valor (mayor→menor)",
                      "fr": "Valeur (décroissant)"
                    },
                    "sort": [
                      {
                        "field": "count",
                        "dir": "desc"
                      },
                      {
                        "field": "name"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "table",
                "columns": [
                  "name",
                  "count",
                  "min",
                  "max",
                  "step"
                ],
                "displays": {
                  "count": {
                    "from": "view_mode"
                  }
                },
                "presets": [
                  {
                    "slug": "name-asc",
                    "name": {
                      "en": "Name (A→Z)",
                      "de": "Name (A→Z)",
                      "es": "Nombre (A→Z)",
                      "fr": "Nom (A→Z)"
                    },
                    "sort": [
                      {
                        "field": "name"
                      }
                    ]
                  },
                  {
                    "slug": "name-desc",
                    "name": {
                      "en": "Name (Z→A)",
                      "de": "Name (Z→A)",
                      "es": "Nombre (Z→A)",
                      "fr": "Nom (Z→A)"
                    },
                    "sort": [
                      {
                        "field": "name",
                        "dir": "desc"
                      }
                    ]
                  },
                  {
                    "slug": "count-asc",
                    "name": {
                      "en": "Count (low→high)",
                      "de": "Stand (niedrig→hoch)",
                      "es": "Valor (menor→mayor)",
                      "fr": "Valeur (croissant)"
                    },
                    "sort": [
                      {
                        "field": "count"
                      },
                      {
                        "field": "name"
                      }
                    ]
                  },
                  {
                    "slug": "count-desc",
                    "name": {
                      "en": "Count (high→low)",
                      "de": "Stand (hoch→niedrig)",
                      "es": "Valor (mayor→menor)",
                      "fr": "Valeur (décroissant)"
                    },
                    "sort": [
                      {
                        "field": "count",
                        "dir": "desc"
                      },
                      {
                        "field": "name"
                      }
                    ]
                  }
                ]
              }
            ],
            "detail": {
              "header": [
                {
                  "type": "stack",
                  "props": {
                    "direction": "row",
                    "gap": "sm",
                    "align": "start"
                  },
                  "children": [
                    {
                      "type": "field",
                      "props": {
                        "field": "name"
                      }
                    },
                    {
                      "type": "actions"
                    }
                  ]
                }
              ],
              "main": [
                {
                  "type": "field",
                  "props": {
                    "field": "count"
                  }
                },
                {
                  "type": "relations"
                }
              ],
              "side": [
                {
                  "type": "section",
                  "children": [
                    {
                      "type": "field",
                      "props": {
                        "field": "color"
                      }
                    },
                    {
                      "type": "field",
                      "props": {
                        "field": "min"
                      }
                    },
                    {
                      "type": "field",
                      "props": {
                        "field": "max"
                      }
                    },
                    {
                      "type": "field",
                      "props": {
                        "field": "step",
                        "required": true
                      }
                    },
                    {
                      "type": "field",
                      "props": {
                        "field": "initial_count",
                        "required": true
                      }
                    },
                    {
                      "type": "field",
                      "props": {
                        "field": "view_mode",
                        "required": true
                      }
                    }
                  ]
                },
                {
                  "type": "section",
                  "children": [
                    {
                      "type": "properties"
                    }
                  ]
                }
              ]
            }
          },
          "open_while": {
            "field": "count",
            "below": {
              "field": "max"
            }
          }
        }
      ],
      "actions": [
        {
          "id": "reset",
          "name": {
            "en": "Reset",
            "de": "Zurücksetzen",
            "es": "Restablecer",
            "fr": "Réinitialiser"
          },
          "on": "counter",
          "write": "{\"set\": {\"count\": item.($start := initial_count; (min != null and $start < min) ? min : (max != null and $start > max) ? max : $start)}}"
        },
        {
          "id": "reset_all",
          "name": {
            "en": "Reset All",
            "de": "Alle zurücksetzen",
            "es": "Restablecer todo",
            "fr": "Tout réinitialiser"
          },
          "on": "counter_group",
          "confirm": {
            "en": "Reset every counter in this group to its initial value?",
            "de": "Jeden Zähler in dieser Gruppe auf seinen Anfangswert zurücksetzen?",
            "es": "¿Restablecer cada contador de este grupo a su valor inicial?",
            "fr": "Réinitialiser chaque compteur de ce groupe à sa valeur initiale ?"
          },
          "write": "{\"items\": {\"counter\": [items.counter.{\"id\": id, \"set\": {\"count\": ($start := initial_count; (min != null and $start < min) ? min : (max != null and $start > max) ? max : $start)}}]}}"
        }
      ]
    },
    "features": [
      "tool"
    ],
    "default_name": "Counters",
    "min_plugin_api": "11.1"
  }
}
