# Test files and dev scripts (not needed in production image)
backend/app/testing/
backend/app/**/*_test.py
backend/alembic/**/*_test.py
backend/app/services/import_engine/fixtures/
backend/scripts/
backend/conftest.py
backend/pytest.ini
backend/.coveragerc

# Python
**/__pycache__
**/*.pyc
backend/.venv

# What a local checkout accumulates, which a build from it would otherwise copy
# in: files uploaded to a dev server, and test and tool output.
backend/uploads/
backend/.coverage*
backend/htmlcov/
backend/.hypothesis/
backend/.testmondata*
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

# Node / frontend build artifacts — installed fresh inside the image. Copying the host's
# (macOS) node_modules over the container's would corrupt the install and bloat the context.
**/node_modules
frontend/dist

**/.env
**/.env.*
!**/.env.example

# Version control
.git
.gitignore

# IDE
.vscode
.idea

# OS
**/.DS_Store
