# General
# Key material — the plug-in platform and handoff signing both take a PEM,
# and openssl writes one wherever it is run. Nothing here is tracked.
*.pem
*.key
.DS_Store
.env
.env.*
!.env.example
.vscode/.dev_seed_ids.json
.idea/
*.log
uploads/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
# No trailing slash. A pattern ending in `/` matches a DIRECTORY only, and
# these are routinely SYMLINKS -- a worktree borrowing an interpreter or an
# install from elsewhere rather than building its own. Git treats a symlink as
# a file, so `foo/` never matches it, `git add -A` sweeps it in, and CI fails
# before running anything:
#
#   error: failed to create directory backend/.venv: File exists
#   ENOTDIR: not a directory, mkdir 'frontend/node_modules'
#
# Four incidents in one week across four branches, each read as a fresh
# mistake rather than a missing rule.
.venv
venv
.pytest_cache/

# Node
node_modules
dist/
*.tsbuildinfo

# Rust — the ratchet's build output. The published wasm artifact under
# frontend/src/crypto/wasm/ IS committed, the way the Orval client is.
crypto/target/

# FastAPI
backend/.mypy_cache/
backend/.ruff_cache/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# Frontend
frontend/node_modules
frontend/dist/
frontend/dist-editor/
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/capacitor.config.js
frontend/capacitor.config.d.ts
frontend/vitest.config.js
frontend/vitest.config.d.ts
frontend/orval.config.js
frontend/orval.config.d.ts
frontend/playwright.config.js
frontend/playwright.config.d.ts
frontend/e2e/**/*.js
frontend/e2e/**/*.d.ts
frontend/openapi.json

